/* styles.css */
:root{
  --accent:#0b57a4;
  --card-bg:rgba(255,255,255,0.95);
  --glass: rgba(255,255,255,0.12);
  --text:#222;
  --radius:12px;
  --maxw:980px;
}

* {box-sizing:border-box}
html,body{height:100%;margin:0;font-family: "Segoe UI", Tahoma, Arial, sans-serif;color:var(--text);background:#f4f7fb}

.bg{
  /* ضع هنا اسم ملف الخلفية الذي أرسلته أو رابط خارجي.
     مثال محلي: campus.jpg  — استبدل بالاسم المناسب */
  background-image: url("campus.jpg");
  background-size: cover;
  background-position: center;
  position:fixed;
  inset:0;
  z-index:0;
  filter: blur(4px) brightness(0.7);
  transform: scale(1.03); /* لتفادي حواف واضحة بعد التمويه */
}

/* تغطية لطبقة لِسَطوع أو تباين إضافي */
.bg::after{
  content:"";
  position:absolute; inset:0;
  background:linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.15));
  pointer-events:none;
}

/* الحاوية الرئيسية */
.container{
  position:relative;
  z-index:2;
  display:flex;
  gap:28px;
  max-width:var(--maxw);
  margin:6vh auto;
  padding:28px;
  align-items:stretch;
}

/* الشريط الجانبي */
.side{
  width:320px;
  background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(255,255,255,0.8));
  border-radius:var(--radius);
  padding:20px;
  box-shadow: 0 6px 24px rgba(8,20,40,0.18);
  backdrop-filter: blur(6px);
  text-align:center;
}
.logo { width:120px; height:auto; display:block; margin:6px auto 12px; }
.side h2 { margin:6px 0 8px; font-size:20px; color:var(--accent) }
.side .desc { font-size:14px; color:#444; margin-bottom:12px }
.side-images { display:flex; gap:8px; justify-content:center; margin-top:10px; }
.side-images img { width:86px; height:56px; object-fit:cover; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.12) }

/* بطاقة تسجيل الدخول */
.login-card{
  flex:1;
  background: var(--card-bg);
  border-radius:var(--radius);
  padding:28px 30px;
  box-shadow: 0 10px 40px rgba(8,20,40,0.18);
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.login-card h1{margin:0 0 18px; font-size:28px; color:var(--accent)}
.login-form{display:flex; flex-direction:column; gap:12px; max-width:420px}
.login-form label{font-size:13px; color:#2b2b2b}
.login-form input[type="email"],
.login-form input[type="password"]{
  padding:12px 14px;
  border:1px solid #d9d9d9;
  border-radius:10px;
  font-size:15px;
  outline:none;
  transition:box-shadow .15s, border-color .12s;
}
.login-form input:focus{
  box-shadow:0 6px 18px rgba(11,87,164,0.12);
  border-color:var(--accent);
}

/* أزرار وإجراءات */
.actions{display:flex; align-items:center; justify-content:space-between; margin-top:8px}
.remember{font-size:14px; color:#444}
.btn{
  background: linear-gradient(180deg,var(--accent), #0a4b8d);
  color:white;
  border:none;
  padding:10px 18px;
  border-radius:10px;
  font-weight:600;
  cursor:pointer;
  box-shadow: 0 6px 16px rgba(11,87,164,0.22);
}
.btn:hover{transform:translateY(-2px)}

.help-links{font-size:13px;color:#666;margin-top:10px}
.help-links a{color:var(--accent); text-decoration:none}

/* تباعد صغير في الفوتر */
.small{font-size:12px;color:#777;margin-top:18px}

/* استجابة شاشات صغيرة */
@media (max-width:880px){
  .container{flex-direction:column; margin:4vh 16px}
  .side{width:100%; order:2}
  .login-card{order:1}
  .side-images img{width:72px;height:52px}
}
